# Copy this file to .env (or .env.local) and fill in values from your
# Firebase console -> Project settings -> General -> Your apps -> Web app config.
#
# All keys are PUBLIC by design (Firebase web config is shipped to the browser).
# Access control is enforced by Firestore Security Rules - see firestore.rules.
#
# To run the app in local-only mode (no cloud), leave these empty and the
# Firebase SDK will not be loaded.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
